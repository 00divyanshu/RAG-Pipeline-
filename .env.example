# ==============================================================================
# Cloud RAG Knowledge Assistant - Environment Template (.env.example)
# Rename this file to '.env' and fill in your actual credentials.
# NOTE: The '.env' file is strictly git-ignored and NEVER pushed to GitHub.
# ==============================================================================

# 1. Relational Database (Neon Serverless PostgreSQL)
# Get your free database URL at: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:your_password@your_endpoint.neon.tech/neondb?sslmode=require

# 2. Cloud AI Providers (Groq & Google Gemini)
# Fast LLM inference with Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Embeddings and Multimodal LLM with Google Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# 3. Vector Database (Pinecone Serverless)
# Get your free API key at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=pdf-rag

# 4. Master Admin Credentials (Overrides defaults)
ADMIN_USERNAME=@dmin
ADMIN_PASSWORD=your_secure_admin_password_here

# 5. Document Processing & Ingestion Settings
DOCS_DIR=data/docs
CHROMA_PERSIST_DIR=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
